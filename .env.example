# herkese görünen marka adı, tescilli ticari unvan ayrıca ayarlanıyor.
NEXT_PUBLIC_COMPANY_NAME=Serhatech
# production: https://serha.tech (yerel önizleme için boş bırak)
NEXT_PUBLIC_SITE_URL=
SITE_INDEXING_ENABLED=false
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
COMPANY_LEGAL_NAME=

# taslak hukuki sayfaları onaylı gerçek metinle değiştirdikten sonra aç.
LEGAL_CONTENT_APPROVED=false

# iletişim formu: alıcıyı sunucu belirliyor, ziyaretçi değiştiremez. gizli anahtarları
# boş bırakırsan gönderim kapalı kalır. asla NEXT_PUBLIC_ ile başlatma.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
# Resend'de notify.serha.tech doğrulandıktan sonra kullanılacak gönderici.
CONTACT_FROM_EMAIL="SERHATECH Form <form@notify.serha.tech>"
CONTACT_TO_EMAIL=serhatvader@gmail.com
CONTACT_SITE_URL=https://serha.tech
# Gerçek HTTPS endpoint ve gizli token sunucudaki .env.local dosyasına eklenir.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# En az 32 karakter, güvenli rastgele değer.
RATE_LIMIT_SECRET=
# Caddy yalnızca güvenilir Cloudflare bağlantısındaki ziyaretçi IP'sini aktarır.
TRUSTED_IP_HEADER=X-Real-IP
