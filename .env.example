# herkese görünen marka adı, tescilli ticari unvan ayrıca ayarlanıyor.
NEXT_PUBLIC_COMPANY_NAME=Serhatech
# production: https://serha.tech (yerel önizleme için boş bırak)
NEXT_PUBLIC_SITE_URL=
SITE_INDEXING_ENABLED=false
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
COMPANY_LEGAL_NAME=

# taslak hukuki sayfaları onaylı gerçek metinle değiştirdikten sonra aç.
LEGAL_CONTENT_APPROVED=false

# iletişim formu: alıcıyı sunucu belirliyor, ziyaretçi değiştiremez. gizli anahtarları
# boş bırakırsan gönderim kapalı kalır. asla NEXT_PUBLIC_ ile başlatma.
RESEND_API_KEY=
# yerel test göndereni. serha.tech'i resend'de doğruladıktan sonra şunu kullan:
# CONTACT_FROM_EMAIL="Serhatech <form@serha.tech>"
CONTACT_FROM_EMAIL=onboarding@resend.dev
CONTACT_TO_EMAIL=iletisim@serha.tech
# isteğe bağlı, formun kabul edeceği origin. boşsa NEXT_PUBLIC_SITE_URL ya da dev
# origin kullanılıyor.
CONTACT_SITE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=

# sadece production: barındırma proxy'nin istemci ip'siyle ÜZERİNE YAZDIĞI başlık.
# ziyaretçinin kendisinin gönderebildiği bir başlığa güvenme.
# doğru ayarlanmış bir caddy proxy'de örnek: X-Real-IP.
TRUSTED_IP_HEADER=
